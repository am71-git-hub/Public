# Kijiji credentials
KIJIJI_EMAIL=your_email@example.com
KIJIJI_PASSWORD=your_password

# Gmail SMTP for status reports (use a Gmail App Password, not your real password)
# Get one at: https://myaccount.google.com/apppasswords
SMTP_FROM_EMAIL=your_gmail@gmail.com
SMTP_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx
REPORT_TO_EMAIL=your_email@example.com

# Kijiji jobs search to watch (optional). Default: all of Canada.
# Search Kijiji in your browser (city, category, keywords), then paste the address here.
# Example: KIJIJI_JOBS_URL=https://www.kijiji.ca/b-jobs/city-of-toronto/c45l1700273
KIJIJI_JOBS_URL=

# How often to poll for new listings (minutes)
POLL_INTERVAL_MINUTES=25

# How often to send an email summary (days)
EMAIL_REPORT_DAYS=4
